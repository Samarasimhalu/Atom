NODE_ENV=development
PORT=3001
AUTH_MODE=development
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=120
GENERATION_RATE_LIMIT_MAX=20
JSON_LIMIT=2mb

# Execution is deny-by-default. Enable only when the hardened image is built,
# scanned, and available to the host/orchestrator.
EXECUTION_ENABLED=false
WORKER_MODE=isolated-image
WORKER_IMAGE=atom-playwright-worker:1.0.0
EXECUTION_HARD_TIMEOUT_MS=300000

VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_DEV_USER=local-developer
VITE_DEV_TENANT_ID=local-tenant

# Durable enterprise infrastructure
DATABASE_URL=postgres://atom:atom@localhost:5432/atom
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
QUEUE_NAME=atom-runs
QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=2

# S3-compatible private object storage; leave endpoint blank for local fallback
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=atom-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
OBJECT_STORAGE_PATH=./data/object-storage
ARTIFACT_RETENTION_DAYS=30
MAX_RUNS_PER_TENANT=1000

# Identity provider foundation (OIDC/SAML integration points)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=

# AI gateway and governance
AI_ALLOWED_MODELS=gpt-4,gpt-3.5-turbo
AI_DEFAULT_MODEL=gpt-4
AI_GENERATION_MODEL=gpt-4
AI_SUMMARY_MODEL=gpt-3.5-turbo
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=30000
AI_MAX_OUTPUT_TOKENS=4000
AI_DAILY_TOKEN_BUDGET=100000
POLICY_REQUIRE_APPROVAL_TAGS=payment,production,destructive
POLICY_BLOCKED_DOMAINS=localhost,127.0.0.1,169.254.169.254
POLICY_MAX_TIMEOUT_MS=300000
EVAL_DATASET_PATH=./evaluations/dataset.json
EVAL_MINIMUM_SCORE=0.85

# Signed terminal-run webhooks
WEBHOOK_SIGNING_SECRET=replace-with-a-random-secret
WEBHOOK_DELIVERY_URL=
WEBHOOK_TIMEOUT_MS=10000
